a:3:{s:5:"value";a:4:{i:0;a:18:{s:2:"id";i:4;s:5:"judul";s:7:"TESTING";s:4:"slug";s:7:"testing";s:8:"kategori";s:3:"TES";s:9:"ringkasan";s:19:"TESTING BERITA DULU";s:6:"konten";s:26:"TESTING INI BERSIFAT WAJIB";s:6:"gambar";s:0:"";s:5:"views";i:2;s:6:"status";s:9:"published";s:9:"author_id";i:1;s:12:"published_at";s:19:"2026-10-14 01:16:00";s:10:"created_at";s:19:"2026-10-14 08:13:20";s:10:"updated_at";s:19:"2026-10-14 08:45:37";s:16:"meta_description";N;s:4:"tags";s:0:"";s:11:"is_featured";i:1;s:14:"allow_comments";i:1;s:10:"sumber_url";N;}i:1;a:18:{s:2:"id";i:2;s:5:"judul";s:45:"Pelatihan Keamanan Siber dan Literasi Digital";s:4:"slug";s:24:"pelatihan-keamanan-siber";s:8:"kategori";s:10:"Pengabdian";s:9:"ringkasan";s:78:"Mahasiswa dan dosen mengadakan pelatihan keamanan siber untuk masyarakat umum.";s:6:"konten";s:144:"<p>Dalam rangka pengabdian masyarakat, Prodi Informatika mengadakan pelatihan keamanan siber untuk meningkatkan literasi digital masyarakat.</p>";s:6:"gambar";N;s:5:"views";i:11;s:6:"status";s:9:"published";s:9:"author_id";N;s:12:"published_at";s:19:"2026-07-01 10:00:00";s:10:"created_at";s:19:"2026-10-11 18:41:49";s:10:"updated_at";s:19:"2026-10-14 08:18:46";s:16:"meta_description";N;s:4:"tags";N;s:11:"is_featured";i:0;s:14:"allow_comments";i:1;s:10:"sumber_url";N;}i:2;a:18:{s:2:"id";i:3;s:5:"judul";s:58:"Pengembangan Website Katalog untuk Percetakan Sangga Buana";s:4:"slug";s:28:"website-katalog-sangga-buana";s:8:"kategori";s:6:"Proyek";s:9:"ringkasan";s:87:"Kolaborasi mahasiswa dalam proyek pengembangan sistem katalog digital untuk UMKM lokal.";s:6:"konten";s:125:"<p>Tim mahasiswa mengembangkan sistem katalog digital modern untuk UMKM percetakan lokal sebagai bentuk kontribusi nyata.</p>";s:6:"gambar";N;s:5:"views";i:0;s:6:"status";s:9:"published";s:9:"author_id";N;s:12:"published_at";s:19:"2026-07-01 10:00:00";s:10:"created_at";s:19:"2026-10-11 18:41:49";s:10:"updated_at";s:19:"2026-10-11 20:04:53";s:16:"meta_description";N;s:4:"tags";N;s:11:"is_featured";i:0;s:14:"allow_comments";i:1;s:10:"sumber_url";N;}i:3;a:18:{s:2:"id";i:1;s:5:"judul";s:53:"Kuliah Tamu "End-to-End AI: Python & Web Application"";s:4:"slug";s:25:"kuliah-tamu-end-to-end-ai";s:8:"kategori";s:8:"Workshop";s:9:"ringkasan";s:104:"Program Studi Informatika gelar workshop intensif tentang pengembangan AI end-to-end menggunakan Python.";s:6:"konten";s:375:"<p>Program Studi Informatika Telkom University Surabaya menggelar kuliah tamu berbasis workshop dengan tema "End-to-End AI: Using Python and Web Application". Acara ini menghadirkan praktisi industri yang berbagi pengalaman nyata dalam pengembangan sistem AI.</p><p>Peserta diajarkan proses lengkap dari pengolahan data, training model, hingga deployment ke aplikasi web.</p>";s:6:"gambar";N;s:5:"views";i:0;s:6:"status";s:9:"published";s:9:"author_id";N;s:12:"published_at";s:19:"2024-11-19 10:00:00";s:10:"created_at";s:19:"2026-10-11 18:41:49";s:10:"updated_at";s:19:"2026-10-11 20:04:53";s:16:"meta_description";N;s:4:"tags";N;s:11:"is_featured";i:0;s:14:"allow_comments";i:1;s:10:"sumber_url";N;}}s:7:"expires";i:1791995444;s:7:"created";i:1791995144;}