a:3:{s:5:"value";a:6:{i:0;a:7:{s:2:"id";i:1;s:10:"pertanyaan";s:56:"Apa saja konsentrasi yang tersedia di Prodi Informatika?";s:7:"jawaban";s:165:"Kami memiliki tiga konsentrasi: Data Science & Intelligent System (DSIS), Communication & Information Technology (CITI), dan Software Engineering & Algorithm (SEAL).";s:6:"urutan";i:1;s:6:"status";s:5:"aktif";s:10:"created_at";s:19:"2026-10-11 18:41:50";s:8:"kategori";s:8:"Akademik";}i:1;a:7:{s:2:"id";i:2;s:10:"pertanyaan";s:44:"Bagaimana prospek kerja lulusan Informatika?";s:7:"jawaban";s:140:"Lulusan kami berkarir sebagai AI Engineer, IT Consultant, System Analyst, Programmer, Network Engineer, dan banyak posisi teknologi lainnya.";s:6:"urutan";i:2;s:6:"status";s:5:"aktif";s:10:"created_at";s:19:"2026-10-11 18:41:50";s:8:"kategori";s:13:"Prospek Karir";}i:2;a:7:{s:2:"id";i:3;s:10:"pertanyaan";s:28:"Apakah ada program beasiswa?";s:7:"jawaban";s:135:"Ya, kami menyediakan berbagai program beasiswa termasuk beasiswa prestasi akademik, beasiswa kurang mampu, dan beasiswa mitra industri.";s:6:"urutan";i:3;s:6:"status";s:5:"aktif";s:10:"created_at";s:19:"2026-10-11 18:41:50";s:8:"kategori";s:16:"Biaya & Beasiswa";}i:3;a:7:{s:2:"id";i:4;s:10:"pertanyaan";s:48:"Bagaimana cara mendaftar sebagai mahasiswa baru?";s:7:"jawaban";s:128:"Klik menu Daftar, isi formulir multi-langkah lengkap dengan berkas, lalu simpan nomor pendaftaran untuk memantau status seleksi.";s:6:"urutan";i:4;s:6:"status";s:5:"aktif";s:10:"created_at";s:19:"2026-10-12 15:59:10";s:8:"kategori";s:11:"Pendaftaran";}i:4;a:7:{s:2:"id";i:5;s:10:"pertanyaan";s:48:"Apakah tersedia kelas karyawan atau kelas malam?";s:7:"jawaban";s:135:"Saat ini perkuliahan reguler dilaksanakan siang hari; kelas karyawan sedang dalam kajian dan akan diumumkan melalui halaman pengumuman.";s:6:"urutan";i:5;s:6:"status";s:5:"aktif";s:10:"created_at";s:19:"2026-10-12 15:59:10";s:8:"kategori";s:8:"Akademik";}i:5;a:7:{s:2:"id";i:6;s:10:"pertanyaan";s:42:"Berapa estimasi biaya kuliah per semester?";s:7:"jawaban";s:116:"Biaya bervariasi sesuai SKS yang diambil. Rincian resmi dapat diminta melalui form kontak atau WhatsApp resmi prodi.";s:6:"urutan";i:6;s:6:"status";s:5:"aktif";s:10:"created_at";s:19:"2026-10-12 15:59:10";s:8:"kategori";s:16:"Biaya & Beasiswa";}}s:7:"expires";i:1791998744;s:7:"created";i:1791995144;}