a:3:{s:5:"value";a:5:{i:0;a:11:{s:2:"id";i:1;s:4:"nama";s:12:"Ivan Sholana";s:11:"tahun_masuk";s:14:"Mahasiswa 2021";s:6:"avatar";s:32:"https://i.pravatar.cc/150?img=12";s:5:"quote";s:117:"Saya merasa sangat diberkahi dengan kesempatan mengasah kemampuan dan kemandirian dalam berkembang di segala kondisi.";s:6:"status";s:8:"approved";s:6:"urutan";i:0;s:10:"created_at";s:19:"2026-10-11 18:41:50";s:4:"role";s:9:"mahasiswa";s:6:"rating";N;s:10:"sosial_url";N;}i:1;a:11:{s:2:"id";i:2;s:4:"nama";s:17:"Whisnumurty Galih";s:11:"tahun_masuk";s:14:"Mahasiswa 2021";s:6:"avatar";s:32:"https://i.pravatar.cc/150?img=33";s:5:"quote";s:119:"Kampus sangat mendukung pengembangan mahasiswa melalui pembimbingan dosen, dukungan fasilitas, dan suasana kolaboratif.";s:6:"status";s:8:"approved";s:6:"urutan";i:0;s:10:"created_at";s:19:"2026-10-11 18:41:50";s:4:"role";s:9:"mahasiswa";s:6:"rating";N;s:10:"sosial_url";N;}i:2;a:11:{s:2:"id";i:3;s:4:"nama";s:17:"Gede Satyamahinsa";s:11:"tahun_masuk";s:14:"Mahasiswa 2022";s:6:"avatar";s:32:"https://i.pravatar.cc/150?img=52";s:5:"quote";s:121:"Dosen aktif dalam penelitian dan sering melibatkan mahasiswa. Kesempatan berharga untuk belajar langsung dari pengalaman.";s:6:"status";s:8:"approved";s:6:"urutan";i:0;s:10:"created_at";s:19:"2026-10-11 18:41:50";s:4:"role";s:9:"mahasiswa";s:6:"rating";N;s:10:"sosial_url";N;}i:3;a:11:{s:2:"id";i:4;s:4:"nama";s:12:"Shinta Putri";s:11:"tahun_masuk";s:14:"Mahasiswa 2023";s:6:"avatar";s:32:"https://i.pravatar.cc/150?img=45";s:5:"quote";s:127:"Dukungan luar biasa dari para dosen. Mereka tidak hanya memberikan ilmu di kelas, tapi selalu siap membantu di luar jam kuliah.";s:6:"status";s:8:"approved";s:6:"urutan";i:0;s:10:"created_at";s:19:"2026-10-11 18:41:50";s:4:"role";s:9:"mahasiswa";s:6:"rating";N;s:10:"sosial_url";N;}i:4;a:11:{s:2:"id";i:5;s:4:"nama";s:13:"Ida Ayu Putri";s:11:"tahun_masuk";s:14:"Mahasiswa 2024";s:6:"avatar";s:32:"https://i.pravatar.cc/150?img=20";s:5:"quote";s:125:"Informatika mengajarkan bahwa matematika bisa dibuat lebih sederhana dengan pemrograman. Logika terasa lebih jelas dan mudah.";s:6:"status";s:8:"approved";s:6:"urutan";i:0;s:10:"created_at";s:19:"2026-10-11 18:41:50";s:4:"role";s:9:"mahasiswa";s:6:"rating";N;s:10:"sosial_url";N;}}s:7:"expires";i:1791995744;s:7:"created";i:1791995144;}