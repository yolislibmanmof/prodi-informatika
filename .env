# ============================================
# KONFIGURASI APLIKASI - PRODI INFORMATIKA
# ============================================
# PENTING: File ini JANGAN di-commit ke Git!
# Simpan credentials sensitif di sini
# ============================================

# ===== APLIKASI =====
APP_NAME="Informatika Pro"
APP_ENV=development
# Ganti ke 'production' saat deploy ke server live
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta

# ===== URL =====
SITE_NAME="Informatika Pro"
# Development
SITE_URL=http://localhost/prodi-informatika
# Production (uncomment saat deploy)
# SITE_URL=https://informatika.ac.id

# ===== DATABASE =====
DB_HOST=localhost
DB_NAME=prodi-informatika
DB_USER=root
DB_PASS=
# Untuk production, gunakan password yang kuat:
# DB_PASS=YourSuperSecurePassword123!

# ===== SESSION =====
SESSION_NAME=IFPROSESS
SESSION_LIFETIME=120
# 120 menit = 2 jam

# ===== SECURITY =====
CSRF_ENABLED=true
RATE_LIMIT_ENABLED=true
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ===== FILE UPLOAD =====
UPLOAD_MAX_SIZE=5242880
# 5MB dalam bytes (5 * 1024 * 1024)

# ===== CACHE =====
CACHE_ENABLED=true
CACHE_DRIVER=file
# Untuk performance lebih baik, ganti ke 'redis' setelah install Redis
CACHE_TTL=3600

# ===== EMAIL (Opsional - untuk fitur notifikasi) =====
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM_EMAIL=noreply@informatika.ac.id
# MAIL_FROM_NAME="Informatika Pro"

# ===== REDIS (Opsional - untuk caching) =====
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=null