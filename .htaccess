# ============================================================
# .htaccess ROOT - PRODI INFORMATIKA (Security + Performance)
# ============================================================

ServerSignature Off
Options -Indexes
RewriteEngine On

# ----- 1) PAKSA HTTPS (Production only, localhost dilewati) -----
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1) [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ----- 2) BLOKIR folder sensitif -----
RewriteRule ^(.*/)?\.(git|svn|env|vscode|idea)(/|$) - [F,L]
RewriteRule ^(cache|logs|includes|database)(/|$) - [F,L]

# ----- 3) BLOKIR pola serangan di query string -----
RewriteCond %{QUERY_STRING} (\.\./|\.\.%2f|<script|base64_[de]code|union.*select|etc/passwd) [NC]
RewriteRule .* - [F,L]

# ----- 4) SECURITY HEADERS -----
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: https:; media-src 'self' https://commondatastorage.googleapis.com https://*.googleapis.com; connect-src 'self'; frame-src 'self' https://www.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
    Header unset X-Powered-By
</IfModule>

# ----- 5) BLOKIR file sensitif -----
<FilesMatch "(?i)\.(sql|log|env|ini|conf|bak|backup|sh|yml|yaml|lock|cache)$">
    Require all denied
</FilesMatch>
<FilesMatch "(?i)^(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|\.gitignore|\.gitattributes)$">
    Require all denied
</FilesMatch>

# ----- 6) CUSTOM ERROR PAGES -----
ErrorDocument 403 /404.php
ErrorDocument 404 /404.php

# ============================================================
# PERFORMANCE SECTION
# ============================================================

# ----- 7) GZIP COMPRESSION -----
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2 application/font-woff application/font-woff2
</IfModule>

# ----- 8) BROWSER CACHING (Aggressive) -----
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # HTML/PHP: selalu revalidasi (konten dinamis)
    ExpiresByType text/html "access plus 0 seconds"
    
    # CSS & JS: 1 tahun (AMAN karena kita pakai asset versioning ?v=...)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # Images: 1 tahun
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Fonts: 1 tahun
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ----- 9) CACHE-CONTROL HEADERS -----
<IfModule mod_headers.c>
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(ico|pdf|jpg|jpeg|png|gif|webp|svg|css|js|woff|woff2|mp4|webm|mp3)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ----- 10) UTF-8 -----
AddDefaultCharset UTF-8