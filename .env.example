# ============================================
# CONTOH KONFIGURASI - JANGAN ISI DATA ASLI
# ============================================

APP_ENV=production
APP_DEBUG=false
APP_URL=https://informatikapro.ac.id

# Database (ganti dengan kredensial produksi)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=prodi_informatika_prod
DB_USER=your_db_user
DB_PASS=your_db_password

# Security
SESSION_LIFETIME=120
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Email (opsional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_ADDRESS=noreply@informatikapro.ac.id
MAIL_FROM_NAME="Informatika Pro"