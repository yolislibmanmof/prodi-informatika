# Template only. Copy to .env locally and replace every placeholder.
# Never commit the real .env file.

APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Makassar
SITE_NAME="Informatika Pro"
SITE_URL=https://informatika.example.ac.id

DB_HOST=localhost
DB_PORT=3306
DB_NAME=prodi_informatika_prod
DB_USER=replace_with_database_user
DB_PASS=replace_with_a_strong_unique_password

SESSION_NAME=IFPROSESS
SESSION_LIFETIME=120
CSRF_ENABLED=true
RATE_LIMIT_ENABLED=true
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
UPLOAD_MAX_SIZE=5242880
CACHE_ENABLED=true
CACHE_DRIVER=file
CACHE_TTL=3600

# Optional e-mail settings
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=noreply@example.ac.id
MAIL_FROM_NAME="Informatika Pro"
